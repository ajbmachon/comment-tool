# comment-tool environment — same convention as jvn and jvr
# Real environment variables always win over this file.
# Which decision service answers is entirely this file + these variables:
#   TypeSafe Jev:  https://api.typesafe.ai      model jev-latest
#   Drex (Nace):   https://drex.nace.ai         model drex-latest
#   Own finetuned: your base URL                model your checkpoint name
TYPESAFE_BASE_URL=https://drex.nace.ai
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=drex-latest
